@keyframes slide-up-check
  0%
    opacity 0
    transform translateY(30px) scale(0.8)

  100%
    opacity 1
    transform translateY(0) scale(1)

.Captcha
  align-items stretch
  display flex
  flex-direction column
  overflow hidden
  user-select none
  width 350px
  padding 12px
  border-radius 12px
  box-sizing content-box
  background #ffffffe6

  header
    box-sizing border-box
    display flex
    flex-direction column
    padding-bottom 16px
    position relative
    width 100%

    > b:first-child
      display flex
      justify-content space-between
      margin-bottom 16px

      > b
        align-items center
        display flex
        gap 6px

        > b:last-child
          background linear-gradient(135deg, #fffdfa, #fff8f0)
          border 1px solid #ffedd5
          border-radius 10px
          box-shadow inset 0 2px 5px #0000000a, inset 0 1px 2px #00000005
          box-sizing content-box
          height 26px
          padding 8px
          width 26px

          > b
            background linear-gradient(135deg, #fbbf24 0, #ea580c 100%)
            display block
            height 100%
            mask-position center
            mask-repeat no-repeat
            mask-size contain
            width 100%

    > b:last-child
      align-items center
      display flex
      justify-content space-between

      > b:first-child
        color #333
        display block
        font-size 16px
        font-weight 600
        text-wrap balance

      button
        align-items center
        background #fff
        border 1px solid #e5e7eb
        border-radius 50%
        box-shadow inset 0 1px 3px #00000014
        cursor pointer
        display flex
        flex-shrink 0
        height 32px
        justify-content center
        margin-left 32px
        outline none
        padding 0
        position relative
        transition all 0.3s cubic-bezier(0.4, 0, 0.2, 1)
        width 32px

        &::before
          background linear-gradient(135deg, #64748b, #94a3b8)
          content ''
          height 18px
          left 50%
          mask-image url('./svg/refresh.svg')
          mask-position center
          mask-repeat no-repeat
          mask-size contain
          position absolute
          top 50%
          transform translate(-50%, -50%)
          transition all 0.3s
          width 18px

        &:hover
          background linear-gradient(135deg, #3b82f6, #2563eb)
          border-color #2563eb
          box-shadow inset 0 2px 4px #00000026
          transform rotate(90deg)

          &::before
            background #fff

        &:active
          background linear-gradient(135deg, #2563eb, #1d4ed8)
          box-shadow inset 0 3px 6px #00000040
          transform rotate(90deg) scale(0.9)

  > b.img
    background-size cover
    box-shadow 0 0 3px inset #0006
    cursor crosshair
    display block
    height 350px
    position relative
    width 100%
    border-radius 12px

  &:not(.ready) > b.img
    background-color #fcfcfc

    > b.mask
      backdrop-filter blur(8px)
      border-radius 12px
      inset 0
      position absolute
      z-index 50
      display flex
      align-items center
      justify-content center

      > b
        background url('./svg/wait.svg') no-repeat center
        background-size contain
        display block
        height 36px
        width 36px

  &:not(.ready)
    header > b:last-child button
      pointer-events none

      &::before
        background #94a3b8
        mask-image url('./svg/wait.svg')

    header > b:first-child > b > b:last-child > b
      background url('./svg/wait.svg') no-repeat 50% 50%
      background-size 60%
      mask-image none !important

  &.suc, &.fail
    > b.img > b.mask
      display flex
      align-items center
      justify-content center

      > b
        animation slide-up-check 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards
        height 56px
        mask-position center
        mask-repeat no-repeat
        mask-size contain
        width 56px

  &.suc
    header > b:first-child > b:first-child
      color #059669

    > b.img > b.mask > b
      background linear-gradient(135deg, #10b981 0, #047857 100%)
      mask-image url('./svg/ok.svg')

  &.fail
    header > b:first-child > b:first-child
      color #f00

    > b.img > b.mask > b
      background linear-gradient(135deg, #f87171 0, #ef4444 100%)
      mask-image url('./svg/xs.svg')

  &.ready
    > b.img > b.bd
      border-width 3px
      cursor pointer
      font-size 15px
      position absolute
      transition all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1)
      z-index 10

      &:hover
        background linear-gradient(135deg, #34d399, #10b981)
        border-color #fff
        box-shadow inset 0 0 4px #0000001a, 0 4px 8px #0003
        transform scale(1.15)

.Captcha .bd
  align-items center
  background linear-gradient(135deg, #10b981, #059669)
  border 2px solid #fff
  border-radius 50%
  box-shadow inset 0 0 4px #0003, 0 2px 4px #00000026
  box-sizing border-box
  color #fff
  display flex
  font-size 16px
  font-variation-settings 'wght' 900
  height 26px
  justify-content center
  padding-bottom 2px
  text-shadow 0 1px 1px #0003
  width 26px
