c-auth
  display flex
  flex-direction column
  width 100%
  box-sizing border-box
  user-select none

  form
    display flex
    flex-direction column
    gap 20px
    width 100%
    box-sizing border-box
    position relative

    h3
      font-size 22px
      font-weight 600
      margin 0
      color #222
      text-align center

    p
      font-size 14px
      color #666
      margin 0
      text-align center
      line-height 1.6

    h3 + p
      margin-top -10px

    footer
      font-size 12px
      color #888
      width 100%
      text-align center
      margin 0

      a
        color #666
        margin 0 4px
        cursor pointer
        white-space nowrap
        position relative
        display inline-block

        &::after
          content ''
          position absolute
          left 0
          right 0
          bottom -2px
          height 1px
          background currentColor

        &:hover
          color #111

  .row
    display flex
    width 100%
    align-items center
    justify-content space-between
    gap 12px

    button[type="submit"]
      flex 1
      min-width 0

    button.sign
      display inline-flex
      align-items center
      justify-content center

      > span + span::before
        content '/'
        margin 0 9px

  .BtnC
    width 44px
    height 44px
    flex-shrink 0
    background-color #fff9

    &:has(> b[data-p='back'])
      width 50px
      height 50px
      border-radius 25px

  .passport
    display flex
    align-items center
    gap 8px
    flex-shrink 0

  .reset
    display flex
    justify-content center
    align-items center
    width 100%
    gap 6px
    font-size 14px
    color #888
    font-weight 400

    a
      color #888
      border-bottom 1px dashed #ccc
      padding-bottom 1px
      cursor pointer
      transition color 0.2s ease, border-color 0.2s ease
      text-decoration none

      &:hover
        color #007aff
        border-color #007aff

  .prov_li
    display flex
    flex-direction column
    gap 12px
    width 100%
    margin-top 12px

  .prov
    display flex
    align-items center
    justify-content center
    gap 12px
    width 100%
    font-size 15px

  b[data-p]
    display inline-block
    width 20px
    height 20px
    background-size contain
    background-position center
    background-repeat no-repeat

    &[data-p='2']
      background-image url('./svg/google.svg')

    &[data-p='3']
      background-image url('./svg/apple.svg')

    &[data-p='4']
      background-image url('./svg/microsoft.svg')

    &[data-p='5']
      background-image url('./svg/wechat.svg')

    &[data-p='6']
      background-image url('./svg/github.svg')

    &[data-p='back']
      background-image url('./svg/back.svg')

    &[data-p='more']
      width 14px
      height 14px
      background-image url('./svg/menu-full.svg')
